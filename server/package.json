{
  "name": "@pact-agent/server",
  "version": "1.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "worker:start": "node dist/worker/index.js",
    "worker": "tsx src/worker/index.ts",
    "seed": "tsx src/seed.ts",
    "audit:tenant-integrity": "tsx src/scripts/auditTenantIntegrity.ts",
    "rotate:webhook-secrets": "tsx src/scripts/rotateWebhookSecrets.ts",
    "rotate:webhook-encryption": "tsx src/scripts/rotateWebhookSecrets.ts",
    "test": "node --import tsx --test --test-concurrency=1 $(find src -type f -name '*.test.ts' ! -name '*.integration.test.ts' -print)",
    "test:integration": "RUN_DB_INTEGRATION_TESTS=true node --import tsx --test --test-concurrency=1 $(find src -type f -name '*.integration.test.ts' -print)",
    "mock:price": "node scripts/mock-price.js",
    "db:push": "npx prisma db push",
    "db:migrate:deploy": "npx prisma migrate deploy",
    "db:migrate:status": "npx prisma migrate status",
    "db:generate": "npx prisma generate",
    "db:studio": "npx prisma studio",
    "lint": "tsc --noEmit",
    "openapi:check": "node --import tsx src/scripts/validateOpenApi.ts",
    "openapi:compat": "node --import tsx src/scripts/checkOpenApiCompatibility.ts",
    "sbom": "cyclonedx-npm --package-lock-only --omit dev --ignore-npm-errors --output-file sbom.cdx.json",
    "retention:run": "node --import tsx src/scripts/applyRetention.ts",
    "audit:verify": "node --import tsx src/scripts/verifyAuditChain.ts"
  },
  "dependencies": {
    "@ckb-ccc/core": "1.12.5",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.220.0",
    "@opentelemetry/sdk-node": "^0.220.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.22.1",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.22.0",
    "prom-client": "^15.1.3",
    "redis": "^6.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@cyclonedx/cyclonedx-npm": "^4.1.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.12.0",
    "@types/pg": "^8.20.0",
    "express-list-endpoints": "^7.1.1",
    "prisma": "^7.8.0",
    "tsx": "^4.11.0",
    "typescript": "^5.4.0"
  },
  "overrides": {
    "@prisma/dev": "0.24.16",
    "brace-expansion": "5.0.8",
    "deepmerge-ts": "8.0.0",
    "fast-uri": "3.1.5",
    "gaxios": "7.3.0",
    "gcp-metadata": "8.1.4",
    "js-yaml": "4.3.1",
    "valibot": "1.4.2"
  }
}
