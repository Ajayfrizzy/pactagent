// PactAgent infrastructure schema.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model App {
  id              String   @id @default(uuid())
  name            String
  slug            String
  ownerId         String
  environment     String   @default("sandbox") // sandbox | production
  status          String   @default("active") // active | disabled | suspended
  defaultCurrency String   @default("CKB")
  defaultNetwork  String   @default("sandbox")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  apiKeys           ApiKey[]
  agreements        Agreement[]
  milestones        Milestone[]
  escrows           Escrow[]
  transactions      Transaction[]
  idempotencyKeys   IdempotencyKey[]
  proofs            Proof[]
  reviews           Review[]
  disputes          Dispute[]
  events            Event[]
  auditLogs         AuditLog[]
  webhookEndpoints  WebhookEndpoint[]
  webhookDeliveries WebhookDelivery[]
  jobs              AgentJob[]

  @@unique([ownerId, slug])
  @@index([ownerId, createdAt])
  @@index([environment, status])
}

model ApiKey {
  id          String    @id @default(uuid())
  appId       String
  name        String
  keyPrefix   String
  keyHash     String    @unique
  environment String    @default("sandbox") // sandbox | production
  status      String    @default("active") // active | revoked
  scopes      String[]
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?

  app App @relation(fields: [appId], references: [id])

  @@index([appId, status])
  @@index([keyPrefix])
  @@index([environment, status])
}

model Agreement {
  id                  String    @id @default(uuid())
  appId               String
  externalReferenceId String?
  title               String
  description         String
  clientExternalId    String?
  workerExternalId    String?
  amount              String // CKB in shannons, stored as string for bigint safety
  currency            String    @default("CKB")
  deadlineAt          DateTime
  disputeWindowSecs   Int       @default(86400) // 24 hours default
  releaseMode         String    @default("milestone") // manual | milestone | automatic
  disputeMode         String    @default("app_managed")
  sourceType          String?
  sourceUrl           String?
  metadataJson        String?
  settlementStatus    String    @default("UNFUNDED") // SettlementStatus enum
  fundingConfirmedAt  DateTime?
  status              String    @default("draft") // infrastructure agreement lifecycle
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  app                        App               @relation(fields: [appId], references: [id])
  milestones                 Milestone[]
  proofs                     Proof[]
  disputes                   Dispute[]
  auditLogs                  AuditLog[]
  jobs                       AgentJob[]
  webhookDeliveries          WebhookDelivery[]
  events                     Event[]
  escrows                    Escrow[]
  infrastructureTransactions Transaction[]
  reviews                    Review[]

  @@unique([appId, externalReferenceId])
  @@unique([id, appId])
  @@index([appId, createdAt])
  @@index([status, createdAt])
  @@index([settlementStatus, createdAt])
  @@index([deadlineAt])
  @@index([status, updatedAt, id])
  @@index([settlementStatus, updatedAt, id])
  @@index([status, deadlineAt, id])
}

model WebhookEndpoint {
  id                   String    @id @default(uuid())
  appId                String
  url                  String
  description          String?
  subscribedEvents     String[]  @default([])
  secretHash           String?
  secretCiphertext     String?
  encryptionKeyVersion String?
  status               String    @default("active") // active | disabled
  deletedAt            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  app        App               @relation(fields: [appId], references: [id])
  deliveries WebhookDelivery[]

  @@unique([id, appId])
  @@index([appId, status, createdAt])
  @@index([encryptionKeyVersion])
}

model WebhookDelivery {
  id                  String    @id @default(uuid())
  appId               String
  endpointId          String
  eventId             String?
  agreementId         String?
  eventType           String
  payloadJson         String
  payloadHash         String
  status              String    @default("PENDING") // PENDING | DELIVERED | FAILED | RETRY
  statusCode          Int?
  responseBodySnippet String?
  attempts            Int       @default(0)
  lastError           String?
  nextRetryAt         DateTime?
  deliveredAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  endpoint  WebhookEndpoint @relation(fields: [endpointId, appId], references: [id, appId], onDelete: Restrict)
  app       App             @relation(fields: [appId], references: [id])
  event     Event?          @relation(fields: [eventId, appId], references: [id, appId], onDelete: Restrict)
  agreement Agreement?      @relation(fields: [agreementId, appId], references: [id, appId], onDelete: Restrict)

  @@unique([id, appId])
  @@index([appId, createdAt])
  @@index([appId, status, nextRetryAt])
  @@index([endpointId, createdAt])
  @@index([eventId, createdAt])
  @@index([status, nextRetryAt, createdAt])
  @@index([agreementId, createdAt])
}

model Milestone {
  id                  String    @id @default(uuid())
  appId               String
  agreementId         String
  externalReferenceId String?
  title               String
  description         String
  amount              String
  currency            String
  sortOrder           Int
  status              String    @default("pending")
  dueDate             DateTime?
  reviewStartedAt     DateTime?
  reviewDeadlineAt    DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  app                        App           @relation(fields: [appId], references: [id])
  agreement                  Agreement     @relation(fields: [agreementId, appId], references: [id, appId], onDelete: Restrict)
  proofs                     Proof[]
  disputes                   Dispute[]
  reviews                    Review[]
  events                     Event[]
  escrows                    Escrow[]
  infrastructureTransactions Transaction[]

  @@unique([appId, externalReferenceId])
  @@unique([agreementId, sortOrder])
  @@unique([id, appId])
  @@unique([id, agreementId, appId])
  @@index([appId, createdAt])
  @@index([agreementId, status])
  @@index([status, reviewDeadlineAt])
}

model Event {
  id                String   @id @default(uuid())
  appId             String
  type              String
  agreementId       String?
  milestoneId       String?
  escrowId          String?
  proofSubmissionId String?
  disputeId         String?
  payloadJson       String
  createdAt         DateTime @default(now())

  app               App               @relation(fields: [appId], references: [id])
  agreement         Agreement?        @relation(fields: [agreementId, appId], references: [id, appId], onDelete: Restrict)
  milestone         Milestone?        @relation(fields: [milestoneId, appId], references: [id, appId], onDelete: Restrict)
  escrow            Escrow?           @relation(fields: [escrowId, appId], references: [id, appId], onDelete: Restrict)
  proof             Proof?            @relation(fields: [proofSubmissionId, appId], references: [id, appId], onDelete: Restrict)
  dispute           Dispute?          @relation(fields: [disputeId, appId], references: [id, appId], onDelete: Restrict)
  webhookDeliveries WebhookDelivery[]

  @@unique([id, appId])
  @@unique([id, agreementId, milestoneId, appId])
  @@index([appId, createdAt])
  @@index([appId, type, createdAt])
  @@index([agreementId, createdAt])
  @@index([milestoneId, createdAt])
}

model Escrow {
  // Active-scope uniqueness is enforced by Phase 2 partial indexes. `failed`
  // remains active because its settlement outcome is unresolved until reconciliation.
  id                   String   @id @default(uuid())
  appId                String
  agreementId          String
  milestoneId          String?
  amount               String
  currency             String
  rail                 String   @default("mock") // mock | manual | ckb
  network              String   @default("sandbox") // sandbox | testnet | mainnet
  status               String   @default("not_created")
  lockAddress          String?
  lockTxHash           String?
  lockOutputIndex      Int?
  lockScriptJson       String?
  clientLockScriptJson String?
  workerLockScriptJson String?
  cellData             String?
  contractVersion      Int?
  refundTimeoutSince   String?
  releaseTxHash        String?
  refundTxHash         String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  app          App           @relation(fields: [appId], references: [id])
  agreement    Agreement     @relation(fields: [agreementId, appId], references: [id, appId], onDelete: Restrict)
  milestone    Milestone?    @relation(fields: [milestoneId, appId], references: [id, appId], onDelete: Restrict)
  events       Event[]
  transactions Transaction[]

  @@unique([id, appId])
  @@index([appId, createdAt])
  @@index([appId, status, createdAt])
  @@index([agreementId, createdAt])
  @@index([milestoneId, createdAt])
}

model Transaction {
  id                  String    @id @default(uuid())
  appId               String
  agreementId         String?
  milestoneId         String?
  escrowId            String?
  type                String // lock | release | refund | manual_adjustment
  rail                String // mock | manual | ckb
  network             String // sandbox | testnet | mainnet
  status              String    @default("pending") // pending | confirmed | failed
  operationId         String?
  txHash              String?
  blockHash           String?
  blockNumber         String?
  confirmations       Int       @default(0)
  lastCheckedAt       DateTime?
  broadcastAt         DateTime?
  confirmedAt         DateTime?
  reconciliationError String?
  amount              String
  currency            String
  rawPayloadJson      String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  app       App        @relation(fields: [appId], references: [id])
  agreement Agreement? @relation(fields: [agreementId, appId], references: [id, appId], onDelete: Restrict)
  milestone Milestone? @relation(fields: [milestoneId, appId], references: [id, appId], onDelete: Restrict)
  escrow    Escrow?    @relation(fields: [escrowId, appId], references: [id, appId], onDelete: Restrict)

  @@unique([id, appId])
  @@unique([appId, operationId])
  @@unique([rail, network, type, txHash, escrowId])
  @@index([appId, createdAt])
  @@index([escrowId, type, createdAt])
  @@index([agreementId, createdAt])
  @@index([milestoneId, createdAt])
}

model IdempotencyKey {
  id                  String   @id @default(uuid())
  appId               String
  key                 String
  requestHash         String
  status              String   @default("pending") // pending | completed
  responseStatus      Int?
  responseBodyJson    Json?    @db.JsonB
  responseBytes       Int?
  processingExpiresAt DateTime
  expiresAt           DateTime
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  app App @relation(fields: [appId], references: [id])

  @@unique([appId, key])
  @@index([appId, createdAt])
  @@index([expiresAt])
  @@index([status, processingExpiresAt])
}

model Proof {
  id                    String   @id @default(uuid())
  appId                 String
  agreementId           String
  milestoneId           String
  submittedByExternalId String?
  proofType             String // text | url | file | github | mixed
  content               String
  contentHash           String
  linksJson             String?
  fileRefsJson          String?
  status                String   @default("submitted")
  submittedAt           DateTime @default(now())
  updatedAt             DateTime @updatedAt

  app       App       @relation(fields: [appId], references: [id])
  agreement Agreement @relation(fields: [agreementId, appId], references: [id, appId], onDelete: Restrict)
  milestone Milestone @relation(fields: [milestoneId, appId], references: [id, appId], onDelete: Restrict)
  reviews   Review[]
  events    Event[]

  @@unique([id, appId])
  @@index([appId, submittedAt])
  @@index([agreementId, milestoneId, submittedAt])
  @@index([milestoneId, status, submittedAt])
}

// Proof review decisions. This is not a reputation or social-review record.
model Review {
  id                 String   @id @default(uuid())
  appId              String
  agreementId        String
  milestoneId        String
  proofSubmissionId  String
  reviewerExternalId String
  decision           String // approved | rejected | needs_changes
  note               String?
  createdAt          DateTime @default(now())

  app       App       @relation(fields: [appId], references: [id])
  agreement Agreement @relation(fields: [agreementId, appId], references: [id, appId], onDelete: Restrict)
  milestone Milestone @relation(fields: [milestoneId, appId], references: [id, appId], onDelete: Restrict)
  proof     Proof     @relation(fields: [proofSubmissionId, appId], references: [id, appId], onDelete: Restrict)

  @@unique([id, appId])
  @@index([appId, createdAt])
  @@index([proofSubmissionId, createdAt])
  @@index([agreementId, createdAt])
}

model Dispute {
  // One unresolved dispute per milestone settlement scope is enforced by a partial index.
  id                 String    @id @default(uuid())
  appId              String
  agreementId        String
  milestoneId        String
  openedByExternalId String?
  reason             String
  evidenceLinksJson  String?
  status             String    @default("open")
  resolutionType     String?
  resolutionNote     String?
  workerAmount       String?
  clientAmount       String?
  resolvedAt         DateTime?
  createdAt          DateTime  @default(now())

  app       App       @relation(fields: [appId], references: [id])
  agreement Agreement @relation(fields: [agreementId, appId], references: [id, appId], onDelete: Restrict)
  milestone Milestone @relation(fields: [milestoneId, appId], references: [id, appId], onDelete: Restrict)
  events    Event[]

  @@unique([id, appId])
  @@index([appId, createdAt])
  @@index([agreementId, milestoneId, resolvedAt])
}

model AuditLog {
  id           String   @id @default(uuid())
  appId        String?
  agreementId  String?
  actorAddress String?
  actorType    String // USER | SYSTEM
  actorId      String?
  action       String
  resourceType String
  resourceId   String
  targetType   String?
  targetId     String?
  metadataJson String?
  beforeJson   String?
  afterJson    String?
  ipAddress    String?
  userAgent    String?
  requestId    String?
  previousHash String?
  recordHash   String?  @unique
  createdAt    DateTime @default(now())

  app       App?       @relation(fields: [appId], references: [id])
  agreement Agreement? @relation(fields: [agreementId, appId], references: [id, appId], onDelete: Restrict)

  @@index([appId, createdAt])
  @@index([agreementId, createdAt])
  @@index([actorAddress, createdAt])
  @@index([requestId, createdAt])
  @@index([resourceType, resourceId, createdAt])
}

model AgentJob {
  id             String    @id @default(uuid())
  appId          String
  agreementId    String?
  kind           String
  queue          String    @default("webhook")
  status         String    @default("QUEUED")
  dedupeKey      String?   @unique
  payloadJson    String?
  attempts       Int       @default(0)
  maxAttempts    Int       @default(5)
  availableAt    DateTime  @default(now())
  lockedAt       DateTime?
  leaseExpiresAt DateTime?
  lockedBy       String?
  lastError      String?
  completedAt    DateTime?
  deadLetteredAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  app       App        @relation(fields: [appId], references: [id])
  agreement Agreement? @relation(fields: [agreementId, appId], references: [id, appId], onDelete: Restrict)

  @@index([queue, status, availableAt, leaseExpiresAt, createdAt])
  @@index([appId, createdAt])
  @@index([agreementId, createdAt])
}

model WorkerHeartbeat {
  id                  String    @id
  service             String    @default("webhook")
  status              String    @default("starting")
  hostname            String
  processId           Int
  version             String
  startedAt           DateTime  @default(now())
  lastHeartbeatAt     DateTime  @default(now())
  lastCycleAt         DateTime?
  lastCycleDurationMs Int?
  cyclesSucceeded     Int       @default(0)
  cyclesFailed        Int       @default(0)
  lastError           String?
  stoppedAt           DateTime?
  updatedAt           DateTime  @updatedAt

  @@index([service, lastHeartbeatAt])
  @@index([status, lastHeartbeatAt])
}
