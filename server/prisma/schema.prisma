// PactAgent Prisma Schema
// Using SQLite for MVP simplicity — swap to PostgreSQL by changing provider + url

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String   @id @default(uuid())
  walletAddress String   @unique
  role          String   @default("client") // client | worker | both
  createdAt     DateTime @default(now())
}

model Agreement {
  id                    String    @id @default(uuid())
  title                 String
  description           String
  clientAddress         String
  workerAddress         String
  arbitratorAddress     String?
  workerFiberPubkey     String?
  amount                String    // CKB in shannons, stored as string for bigint safety
  deadlineAt            DateTime
  disputeWindowSecs     Int       @default(86400) // 24 hours default
  proofType             String    @default("URL") // URL | TEXT | FILE_HASH
  reviewerMode          String    @default("AUTO") // AUTO | HYBRID | MANUAL
  releaseMode           String    @default("FULL") // FULL | PARTIAL
  payoutNetwork         String    @default("CKB") // CKB | FIBER
  escrowModel           String    @default("TREASURY_BRIDGE") // TREASURY_BRIDGE | ONCHAIN_LOCK
  escrowAddress         String?
  escrowLockCodeHash    String?
  escrowLockHashType    String?
  escrowLockArgs        String?
  agreementDigest       String?
  milestoneDigest       String?
  settlementStatus      String    @default("UNFUNDED") // SettlementStatus enum
  fundingConfirmedAt    DateTime?
  lastSettlementError   String?
  ckbTxHashCreate       String?
  ckbTxHashFund         String?
  ckbTxHashRelease      String?
  fiberPaymentReference String?
  status                String    @default("DRAFT") // AgreementStatus enum
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  milestones Milestone[]
  proofs    Proof[]
  disputes  Dispute[]
  agentLogs AgentLog[]
  settlements MilestoneSettlement[]
  auditLogs AuditLog[]
  comments AgreementComment[]
  amendments AgreementAmendment[]
  jobs AgentJob[]
  source AgreementSource?
  ckboostProfileSnapshot CkboostProfileSnapshot?
  ckboostEvents CkboostEvent[]
  ckboostNotificationDeliveries CkboostNotificationDelivery[]
  webhookDeliveries WebhookDelivery[]
  proofChecks ProofCheck[]
  infoRequests InfoRequest[]

  @@index([clientAddress, createdAt])
  @@index([workerAddress, createdAt])
  @@index([status, createdAt])
  @@index([settlementStatus, createdAt])
  @@index([deadlineAt])
}

model PublicProfile {
  id            String   @id @default(uuid())
  walletAddress String   @unique
  handle        String   @unique
  displayName   String?
  bio           String?
  avatarUrl     String?
  skillsJson    String?
  linksJson     String?
  fiberPubkey   String?
  visibility    String   @default("PUBLIC") // PUBLIC | PRIVATE
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([visibility, handle])
  @@index([walletAddress, visibility])
}

model ReputationSnapshot {
  id                         String   @id @default(uuid())
  walletAddress              String   @unique
  completedAgreements        Int      @default(0)
  totalFundedAmount          String   @default("0")
  totalPaidAmount            String   @default("0")
  payoutSuccessRate          Float    @default(0)
  disputeRate                Float    @default(0)
  repeatCounterpartyCount    Int      @default(0)
  onTimeMilestoneRate        Float    @default(0)
  sourceAgreementCount       Int      @default(0)
  updatedAt                  DateTime @updatedAt

  @@index([walletAddress, updatedAt])
}

model InviteLink {
  id                  String   @id @default(uuid())
  token               String   @unique
  createdByAddress    String
  creatorRole         String   // CLIENT | WORKER
  targetRole          String   // CLIENT | WORKER
  title               String?
  description         String?
  agreementTemplateJson String
  expiresAt           DateTime?
  maxUses             Int      @default(1)
  useCount            Int      @default(0)
  acceptedByAddress   String?
  acceptedAt          DateTime?
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([createdByAddress, createdAt])
  @@index([isActive, expiresAt])
}

model AgreementSource {
  id                String   @id @default(uuid())
  agreementId       String   @unique
  sourceType        String   // DAO | BOUNTY
  sourceLabel       String
  externalUrl       String
  forumThreadUrl    String?
  sourceReferenceId String?
  externalMetadataJson String?
  sponsorName       String?
  bountyTitle       String
  bountyDescription String?
  governanceNotes   String?
  syncStatus        String   @default("READY_TO_SYNC") // READY_TO_SYNC | SYNCED | DRAFTED | REVIEWED | PUBLISHED | FAILED | NOT_CONFIGURED
  lastSyncedAt      DateTime?
  latestSummary     String?
  draftUpdate       String?
  lastPublishedAt   DateTime?
  lastPublishedUrl  String?
  lastPublishedExternalId String?
  lastPublishError  String?
  reviewedAt        DateTime?
  reviewedByAddress String?
  createdByAddress  String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  agreement Agreement @relation(fields: [agreementId], references: [id])

  @@index([sourceType, createdAt])
  @@index([createdByAddress, createdAt])
}

model CkboostProfileSnapshot {
  id                      String   @id @default(uuid())
  agreementId             String   @unique
  ckboostProfileId        String?
  contributorExternalId   String?
  walletAddress           String?
  handle                  String?
  displayName             String?
  profileUrl              String?
  campaignParticipationCount Int   @default(0)
  approvedSubmissionCount Int      @default(0)
  rejectedSubmissionCount Int      @default(0)
  approvalRate            Float    @default(0)
  leaderboardRank         Int?
  totalPoints             Int      @default(0)
  totalTipsReceived       String?
  campaignHistoryJson     String?
  statsJson               String?
  lastSyncedAt            DateTime?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  agreement Agreement @relation(fields: [agreementId], references: [id])

  @@index([ckboostProfileId, lastSyncedAt])
  @@index([walletAddress, lastSyncedAt])
}

model CkboostEvent {
  id               String   @id @default(uuid())
  agreementId      String?
  externalEventId  String?
  eventType        String
  payloadJson      String?
  sourceExternalId String?
  contributorExternalId String?
  occurredAt       DateTime
  createdAt        DateTime @default(now())

  agreement Agreement? @relation(fields: [agreementId], references: [id])

  @@index([agreementId, occurredAt])
  @@index([sourceExternalId, occurredAt])
  @@index([contributorExternalId, occurredAt])
  @@index([eventType, occurredAt])
}

model CkboostNotificationDelivery {
  id           String    @id @default(uuid())
  agreementId   String
  eventType     String
  payloadJson   String
  status        String    @default("PENDING") // PENDING | DELIVERED | FAILED | RETRY
  statusCode    Int?
  attempts      Int       @default(0)
  lastError     String?
  nextRetryAt   DateTime?
  deliveredAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  agreement Agreement @relation(fields: [agreementId], references: [id])

  @@index([agreementId, createdAt])
  @@index([status, nextRetryAt, createdAt])
}

model WebhookEndpoint {
  id             String   @id @default(uuid())
  ownerAddress   String
  label          String?
  targetUrl      String
  eventTypesJson String
  signingSecret  String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  deliveries WebhookDelivery[]

  @@index([ownerAddress, createdAt])
  @@index([isActive, createdAt])
}

model WebhookDelivery {
  id           String    @id @default(uuid())
  endpointId    String
  agreementId   String?
  eventType     String
  payloadJson   String
  payloadHash   String
  status        String    @default("PENDING") // PENDING | DELIVERED | FAILED | RETRY
  statusCode    Int?
  attempts      Int       @default(0)
  lastError     String?
  nextRetryAt   DateTime?
  deliveredAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  endpoint  WebhookEndpoint @relation(fields: [endpointId], references: [id])
  agreement Agreement?      @relation(fields: [agreementId], references: [id])

  @@index([endpointId, createdAt])
  @@index([status, nextRetryAt, createdAt])
  @@index([agreementId, createdAt])
}

model Milestone {
  id          String   @id @default(uuid())
  agreementId String
  title       String
  description String
  amount      String
  sortOrder   Int
  status      String   @default("PENDING")
  escrowFundingTxHash String?
  escrowOutputIndex   Int?
  escrowCellData      String?
  refundTimeoutBlock  BigInt?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  agreement Agreement @relation(fields: [agreementId], references: [id])
  proofs    Proof[]
  disputes  Dispute[]
  settlements MilestoneSettlement[]
  proofChecks ProofCheck[]
  infoRequests InfoRequest[]

  @@unique([agreementId, sortOrder])
  @@index([agreementId, status])
}

model Proof {
  id          String   @id @default(uuid())
  agreementId String
  milestoneId String
  proofType   String   // URL | TEXT | FILE_HASH
  content     String
  contentHash String
  submittedAt DateTime @default(now())
  reviewStatus String  @default("UNREVIEWED") // UNREVIEWED | CHECKING | ISSUES_FOUND | READY_FOR_HUMAN_REVIEW | NEEDS_MORE_INFO
  lastCheckedAt DateTime?

  agreement Agreement @relation(fields: [agreementId], references: [id])
  milestone Milestone @relation(fields: [milestoneId], references: [id])
  proofChecks ProofCheck[]
  infoRequests InfoRequest[]

  @@index([agreementId, milestoneId, submittedAt])
  @@index([milestoneId, reviewStatus, submittedAt])
}

model ProofCheck {
  id           String   @id @default(uuid())
  agreementId   String
  milestoneId   String
  proofId       String
  status        String   // CHECKING | ISSUES_FOUND | READY_FOR_HUMAN_REVIEW | NEEDS_MORE_INFO
  issueCount    Int      @default(0)
  warningCount  Int      @default(0)
  summary       String
  warningsJson  String?
  checklistJson String?
  triggeredByAddress String?
  triggeredByType String  @default("USER") // USER | SYSTEM
  asyncJobId    String?
  completedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  agreement Agreement @relation(fields: [agreementId], references: [id])
  milestone Milestone @relation(fields: [milestoneId], references: [id])
  proof     Proof     @relation(fields: [proofId], references: [id])

  @@index([agreementId, milestoneId, createdAt])
  @@index([proofId, createdAt])
  @@index([status, createdAt])
}

model InfoRequest {
  id             String   @id @default(uuid())
  agreementId     String
  milestoneId     String
  proofId         String?
  requestType     String   @default("STRUCTURED_REVIEW_REQUEST") // STRUCTURED_REVIEW_REQUEST | MESSAGE
  status          String   @default("OPEN") // OPEN | RESPONDED | CLOSED
  requestedBy     String
  note            String?
  questionsJson   String
  responseContent String?
  respondedBy     String?
  respondedAt     DateTime?
  commentId       String?
  responseCommentId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  agreement Agreement @relation(fields: [agreementId], references: [id])
  milestone Milestone @relation(fields: [milestoneId], references: [id])
  proof     Proof?    @relation(fields: [proofId], references: [id])

  @@index([agreementId, milestoneId, createdAt])
  @@index([status, createdAt])
}

model Dispute {
  id               String    @id @default(uuid())
  agreementId      String
  milestoneId      String
  openedBy         String    // wallet address
  reason           String
  evidenceNotes    String?
  aiSummary        String?
  aiRecommendation String?   // DisputeRecommendation enum
  aiConfidence     Float?
  aiRationale      String?
  resolvedAt       DateTime?
  createdAt        DateTime  @default(now())

  agreement       Agreement       @relation(fields: [agreementId], references: [id])
  milestone       Milestone       @relation(fields: [milestoneId], references: [id])
  evidenceEntries DisputeEvidence[]

  @@index([agreementId, milestoneId, resolvedAt])
}

model DisputeEvidence {
  id          String   @id @default(uuid())
  disputeId   String
  submittedBy String
  content     String
  createdAt   DateTime @default(now())

  dispute Dispute @relation(fields: [disputeId], references: [id])

  @@index([disputeId, createdAt])
}

model AgentLog {
  id           String   @id @default(uuid())
  agreementId  String?
  level        String   // INFO | WARN | ERROR | SUCCESS
  eventType    String   // AgentEventType enum
  message      String
  metadataJson String?  // JSON string for flexible metadata
  createdAt    DateTime @default(now())

  agreement Agreement? @relation(fields: [agreementId], references: [id])

  @@index([agreementId, createdAt])
  @@index([eventType, createdAt])
}

model AuditLog {
  id           String   @id @default(uuid())
  agreementId  String?
  actorAddress String?
  actorType    String   // USER | SYSTEM
  action       String
  resourceType String   // AGREEMENT | DISPUTE | SETTLEMENT | FIBER
  resourceId   String
  metadataJson String?
  createdAt    DateTime @default(now())

  agreement Agreement? @relation(fields: [agreementId], references: [id])

  @@index([agreementId, createdAt])
  @@index([actorAddress, createdAt])
  @@index([resourceType, resourceId, createdAt])
}

model MilestoneSettlement {
  id               String   @id @default(uuid())
  agreementId       String
  milestoneId       String?
  direction         String   // FUNDING | PAYOUT | REFUND
  network           String   // CKB | FIBER | INTERNAL
  status            String   @default("PENDING") // PENDING | CONFIRMED | FAILED
  amount            String
  txHash            String?
  paymentReference  String?
  errorMessage      String?
  confirmedAt       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  agreement Agreement @relation(fields: [agreementId], references: [id])
  milestone Milestone? @relation(fields: [milestoneId], references: [id])

  @@index([agreementId, direction, status, createdAt])
  @@index([milestoneId, direction, createdAt])
}

model AgreementComment {
  id            String   @id @default(uuid())
  agreementId    String
  authorAddress  String
  content        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  agreement Agreement @relation(fields: [agreementId], references: [id])

  @@index([agreementId, createdAt])
}

model AgreementAmendment {
  id               String   @id @default(uuid())
  agreementId       String
  proposedBy        String
  status            String   @default("PROPOSED")
  reason            String?
  title             String?
  description       String?
  deadlineAt        DateTime?
  disputeWindowSecs Int?
  releaseMode       String?
  payoutNetwork     String?
  workerFiberPubkey String?
  milestonesJson    String?
  responseNote      String?
  respondedAt       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  agreement Agreement @relation(fields: [agreementId], references: [id])

  @@index([agreementId, status, createdAt])
}

model AgentJob {
  id             String    @id @default(uuid())
  agreementId     String?
  kind           String
  status         String    @default("QUEUED")
  dedupeKey      String?   @unique
  payloadJson    String?
  attempts       Int       @default(0)
  maxAttempts    Int       @default(5)
  availableAt    DateTime  @default(now())
  lockedAt       DateTime?
  lockedBy       String?
  lastError      String?
  completedAt    DateTime?
  deadLetteredAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  agreement Agreement? @relation(fields: [agreementId], references: [id])

  @@index([status, availableAt, createdAt])
  @@index([agreementId, createdAt])
}
