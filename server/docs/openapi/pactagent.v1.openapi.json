{
  "openapi": "3.1.0",
  "info": {
    "title": "PactAgent Infrastructure API",
    "version": "1.0.0",
    "description": "App-scoped infrastructure API for agreements, milestones, escrow records, proof review, disputes, lifecycle events, webhooks, audit logs, and operator administration. Product-specific user experiences are intentionally outside this API."
  },
  "servers": [
    { "url": "http://localhost:4000", "description": "Local development" }
  ],
  "tags": [
    { "name": "Operator Auth" },
    { "name": "Apps" },
    { "name": "API Keys" },
    { "name": "Agreements" },
    { "name": "Milestones" },
    { "name": "Escrows" },
    { "name": "Transactions" },
    { "name": "Proofs" },
    { "name": "Reviews" },
    { "name": "Disputes" },
    { "name": "Events" },
    { "name": "Webhooks" },
    { "name": "Audit" },
    { "name": "Admin" }
  ],
  "security": [{ "apiKey": [] }],
  "components": {
    "securitySchemes": {
      "apiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key",
        "description": "App-scoped API key. PactAgent keys are returned once when created."
      },
      "operatorBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Operator session created by the CKB wallet challenge flow."
      }
    },
    "parameters": {
      "Id": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "format": "uuid" }
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "description": "A caller-generated key used to safely retry a sensitive mutation.",
        "schema": { "type": "string", "minLength": 1, "maxLength": 200 }
      },
      "Limit": {
        "name": "limit",
        "in": "query",
        "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 }
      },
      "Cursor": {
        "name": "cursor",
        "in": "query",
        "schema": { "type": "string" }
      }
    },
    "responses": {
      "Success": {
        "description": "Successful response",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/DataEnvelope" }
          }
        }
      },
      "Created": {
        "description": "Resource created",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/DataEnvelope" }
          }
        }
      },
      "List": {
        "description": "Cursor-paginated list",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ListEnvelope" }
          }
        }
      },
      "Error": {
        "description": "Authentication, authorization, validation, conflict, rate-limit, or server error",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
          }
        }
      }
    },
    "schemas": {
      "DataEnvelope": {
        "type": "object",
        "required": ["data"],
        "properties": {
          "data": {},
          "requestId": { "type": "string" }
        }
      },
      "ListEnvelope": {
        "type": "object",
        "required": ["data", "pagination"],
        "properties": {
          "data": { "type": "array", "items": {} },
          "pagination": { "$ref": "#/components/schemas/Pagination" },
          "requestId": { "type": "string" }
        }
      },
      "Pagination": {
        "type": "object",
        "required": ["limit", "cursor"],
        "properties": {
          "limit": { "type": "integer" },
          "cursor": { "type": ["string", "null"] }
        }
      },
      "ErrorEnvelope": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["type", "code", "message"],
            "properties": {
              "type": { "type": "string" },
              "code": { "type": "string" },
              "message": { "type": "string" },
              "requestId": { "type": "string" }
            }
          }
        }
      },
      "AuthChallengeRequest": {
        "type": "object",
        "required": ["address"],
        "properties": { "address": { "type": "string", "minLength": 1 } }
      },
      "AuthVerifyRequest": {
        "type": "object",
        "required": ["address", "message", "signature"],
        "properties": {
          "address": { "type": "string" },
          "message": { "type": "string" },
          "signature": {
            "type": "object",
            "required": ["signature", "identity", "signType"],
            "properties": {
              "signature": { "type": "string" },
              "identity": { "type": "string" },
              "signType": { "type": "string" }
            }
          }
        }
      },
      "AppInput": {
        "type": "object",
        "required": ["name", "slug"],
        "properties": {
          "name": { "type": "string", "maxLength": 120 },
          "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "environment": { "type": "string", "enum": ["sandbox", "production"], "default": "sandbox" },
          "defaultCurrency": { "type": "string", "default": "CKB" },
          "defaultNetwork": { "type": "string", "default": "sandbox" }
        }
      },
      "AppUpdate": {
        "type": "object",
        "minProperties": 1,
        "properties": {
          "name": { "type": "string", "maxLength": 120 },
          "status": { "type": "string", "enum": ["active", "disabled", "suspended"] },
          "defaultCurrency": { "type": "string" },
          "defaultNetwork": { "type": "string" }
        }
      },
      "ApiKeyInput": {
        "type": "object",
        "required": ["appId", "name", "scopes"],
        "properties": {
          "appId": { "type": "string", "format": "uuid" },
          "name": { "type": "string", "maxLength": 120 },
          "scopes": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      },
      "AgreementInput": {
        "type": "object",
        "required": ["title", "clientExternalId", "workerExternalId", "totalAmount"],
        "properties": {
          "externalReferenceId": { "type": "string", "maxLength": 160 },
          "title": { "type": "string", "maxLength": 200 },
          "description": { "type": "string", "maxLength": 5000 },
          "clientExternalId": { "type": "string", "maxLength": 160 },
          "workerExternalId": { "type": "string", "maxLength": 160 },
          "totalAmount": { "type": "string", "pattern": "^[1-9][0-9]*$" },
          "currency": { "type": "string", "default": "CKB" },
          "releaseMode": { "type": "string", "enum": ["manual", "milestone", "automatic"], "default": "milestone" },
          "disputeMode": { "type": "string", "enum": ["app_managed", "pactagent_managed"], "default": "app_managed" },
          "sourceType": { "type": "string" },
          "sourceUrl": { "type": "string", "format": "uri" },
          "metadata": { "type": "object", "additionalProperties": true }
        }
      },
      "MilestoneInput": {
        "type": "object",
        "required": ["title", "amount"],
        "properties": {
          "externalReferenceId": { "type": "string" },
          "title": { "type": "string", "maxLength": 160 },
          "description": { "type": "string", "maxLength": 3000 },
          "amount": { "type": "string", "pattern": "^[1-9][0-9]*$" },
          "currency": { "type": "string" },
          "order": { "type": "integer", "minimum": 1 },
          "dueDate": { "type": "string", "format": "date-time" }
        }
      },
      "EscrowInput": {
        "type": "object",
        "required": ["agreementId", "amount"],
        "properties": {
          "agreementId": { "type": "string", "format": "uuid" },
          "milestoneId": { "type": "string", "format": "uuid" },
          "amount": { "type": "string", "pattern": "^[1-9][0-9]*$" },
          "currency": { "type": "string", "default": "CKB" },
          "rail": { "type": "string", "enum": ["mock", "manual", "ckb"], "default": "mock" },
          "network": { "type": "string", "enum": ["sandbox", "testnet", "mainnet"], "default": "sandbox" }
        }
      },
      "ProofInput": {
        "type": "object",
        "required": ["agreementId", "milestoneId", "submittedByExternalId", "type", "content"],
        "properties": {
          "agreementId": { "type": "string", "format": "uuid" },
          "milestoneId": { "type": "string", "format": "uuid" },
          "submittedByExternalId": { "type": "string" },
          "type": { "type": "string", "enum": ["text", "url", "file", "github", "mixed"] },
          "content": { "type": "string", "maxLength": 20000 },
          "links": { "type": "array", "maxItems": 10, "items": { "type": "string", "format": "uri" } },
          "fileRefs": { "type": "array", "maxItems": 20, "items": { "type": "string" } }
        }
      },
      "ProofReviewInput": {
        "type": "object",
        "required": ["reviewerExternalId", "decision"],
        "properties": {
          "reviewerExternalId": { "type": "string" },
          "decision": { "type": "string", "enum": ["approved", "rejected", "needs_changes"] },
          "note": { "type": "string", "maxLength": 5000 }
        }
      },
      "DisputeInput": {
        "type": "object",
        "required": ["agreementId", "milestoneId", "openedByExternalId", "reason"],
        "properties": {
          "agreementId": { "type": "string", "format": "uuid" },
          "milestoneId": { "type": "string", "format": "uuid" },
          "openedByExternalId": { "type": "string" },
          "reason": { "type": "string", "maxLength": 5000 },
          "evidenceLinks": { "type": "array", "maxItems": 20, "items": { "type": "string", "format": "uri" } }
        }
      },
      "DisputeResolutionInput": {
        "type": "object",
        "required": ["resolutionType"],
        "properties": {
          "resolutionType": { "type": "string", "enum": ["release", "refund", "split"] },
          "resolutionNote": { "type": "string", "maxLength": 5000 },
          "workerAmount": { "type": "string", "pattern": "^[1-9][0-9]*$" },
          "clientAmount": { "type": "string", "pattern": "^[1-9][0-9]*$" }
        }
      },
      "WebhookInput": {
        "type": "object",
        "required": ["url", "subscribedEvents"],
        "properties": {
          "url": { "type": "string", "format": "uri", "maxLength": 2048 },
          "description": { "type": "string", "maxLength": 240 },
          "subscribedEvents": { "type": "array", "minItems": 1, "maxItems": 50, "items": { "type": "string" } }
        }
      },
      "WebhookUpdate": {
        "type": "object",
        "minProperties": 1,
        "properties": {
          "url": { "type": "string", "format": "uri", "maxLength": 2048 },
          "description": { "type": ["string", "null"], "maxLength": 240 },
          "subscribedEvents": { "type": "array", "minItems": 1, "maxItems": 50, "items": { "type": "string" } },
          "status": { "type": "string", "enum": ["active", "disabled"] }
        }
      }
    }
  },
  "paths": {
    "/v1/auth/challenge": {
      "post": {
        "tags": ["Operator Auth"], "summary": "Create a wallet sign-in challenge", "security": [],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AuthChallengeRequest" } } } },
        "responses": { "200": { "$ref": "#/components/responses/Success" }, "default": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/v1/auth/verify": {
      "post": {
        "tags": ["Operator Auth"], "summary": "Verify a signed wallet challenge", "security": [],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AuthVerifyRequest" } } } },
        "responses": { "200": { "$ref": "#/components/responses/Success" }, "default": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/v1/auth/me": {
      "get": { "tags": ["Operator Auth"], "summary": "Get the current operator session", "security": [{ "operatorBearer": [] }], "responses": { "200": { "$ref": "#/components/responses/Success" }, "default": { "$ref": "#/components/responses/Error" } } }
    },
    "/v1/apps/current": {
      "get": { "tags": ["Apps"], "summary": "Get the app resolved from the current API key", "responses": { "200": { "$ref": "#/components/responses/Success" }, "default": { "$ref": "#/components/responses/Error" } } }
    },
    "/v1/apps": {
      "post": { "tags": ["Apps"], "summary": "Create an app", "security": [{ "operatorBearer": [] }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AppInput" } } } }, "responses": { "201": { "$ref": "#/components/responses/Created" }, "default": { "$ref": "#/components/responses/Error" } } },
      "get": { "tags": ["Apps"], "summary": "List operator-owned apps", "security": [{ "operatorBearer": [] }], "parameters": [{ "$ref": "#/components/parameters/Limit" }, { "$ref": "#/components/parameters/Cursor" }], "responses": { "200": { "$ref": "#/components/responses/List" }, "default": { "$ref": "#/components/responses/Error" } } }
    },
    "/v1/apps/{id}": {
      "get": { "tags": ["Apps"], "summary": "Get an operator-owned app", "security": [{ "operatorBearer": [] }], "parameters": [{ "$ref": "#/components/parameters/Id" }], "responses": { "200": { "$ref": "#/components/responses/Success" }, "default": { "$ref": "#/components/responses/Error" } } },
      "patch": { "tags": ["Apps"], "summary": "Update an operator-owned app", "security": [{ "operatorBearer": [] }], "parameters": [{ "$ref": "#/components/parameters/Id" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AppUpdate" } } } }, "responses": { "200": { "$ref": "#/components/responses/Success" }, "default": { "$ref": "#/components/responses/Error" } } }
    },
    "/v1/apps/{id}/disable": {
      "post": { "tags": ["Apps"], "summary": "Disable an operator-owned app", "security": [{ "operatorBearer": [] }], "parameters": [{ "$ref": "#/components/parameters/Id" }], "responses": { "200": { "$ref": "#/components/responses/Success" }, "default": { "$ref": "#/components/responses/Error" } } }
    },
    "/v1/api-keys": {
      "post": { "tags": ["API Keys"], "summary": "Create an app API key", "security": [{ "operatorBearer": [] }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiKeyInput" } } } }, "responses": { "201": { "$ref": "#/components/responses/Created" }, "default": { "$ref": "#/components/responses/Error" } } },
      "get": { "tags": ["API Keys"], "summary": "List operator-managed API keys", "security": [{ "operatorBearer": [] }], "parameters": [{ "name": "appId", "in": "query", "schema": { "type": "string", "format": "uuid" } }, { "$ref": "#/components/parameters/Limit" }, { "$ref": "#/components/parameters/Cursor" }], "responses": { "200": { "$ref": "#/components/responses/List" }, "default": { "$ref": "#/components/responses/Error" } } }
    },
    "/v1/api-keys/{id}": {
      "delete": { "tags": ["API Keys"], "summary": "Revoke an API key", "security": [{ "operatorBearer": [] }], "parameters": [{ "$ref": "#/components/parameters/Id" }], "responses": { "200": { "$ref": "#/components/responses/Success" }, "default": { "$ref": "#/components/responses/Error" } } }
    },
    "/v1/agreements": {
      "post": { "tags": ["Agreements"], "summary": "Create an app-scoped agreement", "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AgreementInput" } } } }, "responses": { "201": { "$ref": "#/components/responses/Created" }, "default": { "$ref": "#/components/responses/Error" } } },
      "get": { "tags": ["Agreements"], "summary": "List app-scoped agreements", "parameters": [{ "name": "status", "in": "query", "schema": { "type": "string" } }, { "name": "externalReferenceId", "in": "query", "schema": { "type": "string" } }, { "$ref": "#/components/parameters/Limit" }, { "$ref": "#/components/parameters/Cursor" }], "responses": { "200": { "$ref": "#/components/responses/List" }, "default": { "$ref": "#/components/responses/Error" } } }
    },
    "/v1/agreements/{id}": {
      "get": { "tags": ["Agreements"], "summary": "Get an app-scoped agreement", "parameters": [{ "$ref": "#/components/parameters/Id" }], "responses": { "200": { "$ref": "#/components/responses/Success" }, "default": { "$ref": "#/components/responses/Error" } } }
    },
    "/v1/agreements/{id}/accept": {
      "post": { "tags": ["Agreements"], "summary": "Accept an agreement", "parameters": [{ "$ref": "#/components/parameters/Id" }], "responses": { "200": { "$ref": "#/components/responses/Success" }, "default": { "$ref": "#/components/responses/Error" } } }
    },
    "/v1/agreements/{id}/funding-required": {
      "post": { "tags": ["Agreements"], "summary": "Move an accepted agreement to funding required", "parameters": [{ "$ref": "#/components/parameters/Id" }], "responses": { "200": { "$ref": "#/components/responses/Success" }, "default": { "$ref": "#/components/responses/Error" } } }
    },
    "/v1/agreements/{id}/cancel": {
      "post": { "tags": ["Agreements"], "summary": "Cancel an agreement", "parameters": [{ "$ref": "#/components/parameters/Id" }], "responses": { "200": { "$ref": "#/components/responses/Success" }, "default": { "$ref": "#/components/responses/Error" } } }
    },
    "/v1/agreements/{id}/milestones": {
      "post": { "tags": ["Milestones"], "summary": "Create a milestone under an agreement", "parameters": [{ "$ref": "#/components/parameters/Id" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MilestoneInput" } } } }, "responses": { "201": { "$ref": "#/components/responses/Created" }, "default": { "$ref": "#/components/responses/Error" } } },
      "get": { "tags": ["Milestones"], "summary": "List milestones under an agreement", "parameters": [{ "$ref": "#/components/parameters/Id" }, { "$ref": "#/components/parameters/Limit" }, { "$ref": "#/components/parameters/Cursor" }], "responses": { "200": { "$ref": "#/components/responses/List" }, "default": { "$ref": "#/components/responses/Error" } } }
    },
    "/v1/milestones": {
      "get": { "tags": ["Milestones"], "summary": "List app-scoped milestones", "parameters": [{ "name": "agreementId", "in": "query", "schema": { "type": "string", "format": "uuid" } }, { "name": "status", "in": "query", "schema": { "type": "string" } }, { "$ref": "#/components/parameters/Limit" }, { "$ref": "#/components/parameters/Cursor" }], "responses": { "200": { "$ref": "#/components/responses/List" }, "default": { "$ref": "#/components/responses/Error" } } }
    },
    "/v1/milestones/{id}": {
      "get": { "tags": ["Milestones"], "summary": "Get an app-scoped milestone", "parameters": [{ "$ref": "#/components/parameters/Id" }], "responses": { "200": { "$ref": "#/components/responses/Success" }, "default": { "$ref": "#/components/responses/Error" } } }
    },
    "/v1/escrows": {
      "post": { "tags": ["Escrows"], "summary": "Create a mock, manual, or CKB escrow record", "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EscrowInput" } } } }, "responses": { "201": { "$ref": "#/components/responses/Created" }, "default": { "$ref": "#/components/responses/Error" } } },
      "get": { "tags": ["Escrows"], "summary": "List app-scoped escrows", "parameters": [{ "name": "agreementId", "in": "query", "schema": { "type": "string", "format": "uuid" } }, { "name": "status", "in": "query", "schema": { "type": "string" } }, { "$ref": "#/components/parameters/Limit" }, { "$ref": "#/components/parameters/Cursor" }], "responses": { "200": { "$ref": "#/components/responses/List" }, "default": { "$ref": "#/components/responses/Error" } } }
    },
    "/v1/escrows/{id}": {
      "get": { "tags": ["Escrows"], "summary": "Get an app-scoped escrow", "parameters": [{ "$ref": "#/components/parameters/Id" }], "responses": { "200": { "$ref": "#/components/responses/Success" }, "default": { "$ref": "#/components/responses/Error" } } }
    },
    "/v1/escrows/{id}/mark-funded": {
      "post": { "tags": ["Escrows"], "summary": "Mark a mock or manual escrow funded", "parameters": [{ "$ref": "#/components/parameters/Id" }], "requestBody": { "content": { "application/json": { "schema": { "type": "object", "properties": { "txHash": { "type": "string", "maxLength": 200 } } } } } }, "responses": { "200": { "$ref": "#/components/responses/Success" }, "default": { "$ref": "#/components/responses/Error" } } }
    },
    "/v1/escrows/{id}/release": {
      "post": { "tags": ["Escrows"], "summary": "Release a funded escrow", "parameters": [{ "$ref": "#/components/parameters/Id" }, { "$ref": "#/components/parameters/IdempotencyKey" }], "responses": { "200": { "$ref": "#/components/responses/Success" }, "default": { "$ref": "#/components/responses/Error" } } }
    },
    "/v1/escrows/{id}/refund": {
      "post": { "tags": ["Escrows"], "summary": "Refund a funded escrow", "parameters": [{ "$ref": "#/components/parameters/Id" }, { "$ref": "#/components/parameters/IdempotencyKey" }], "responses": { "200": { "$ref": "#/components/responses/Success" }, "default": { "$ref": "#/components/responses/Error" } } }
    },
    "/v1/transactions": {
      "get": { "tags": ["Transactions"], "summary": "List app-scoped transaction records", "parameters": [{ "$ref": "#/components/parameters/Limit" }, { "$ref": "#/components/parameters/Cursor" }], "responses": { "200": { "$ref": "#/components/responses/List" }, "default": { "$ref": "#/components/responses/Error" } } }
    },
    "/v1/proofs": {
      "post": { "tags": ["Proofs"], "summary": "Submit proof for a milestone", "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProofInput" } } } }, "responses": { "201": { "$ref": "#/components/responses/Created" }, "default": { "$ref": "#/components/responses/Error" } } },
      "get": { "tags": ["Proofs"], "summary": "List app-scoped proof submissions", "parameters": [{ "$ref": "#/components/parameters/Limit" }, { "$ref": "#/components/parameters/Cursor" }], "responses": { "200": { "$ref": "#/components/responses/List" }, "default": { "$ref": "#/components/responses/Error" } } }
    },
    "/v1/proofs/{id}": {
      "get": { "tags": ["Proofs"], "summary": "Get a proof submission", "parameters": [{ "$ref": "#/components/parameters/Id" }], "responses": { "200": { "$ref": "#/components/responses/Success" }, "default": { "$ref": "#/components/responses/Error" } } }
    },
    "/v1/proofs/{id}/review": {
      "post": { "tags": ["Proofs"], "summary": "Record a proof review decision", "parameters": [{ "$ref": "#/components/parameters/Id" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProofReviewInput" } } } }, "responses": { "200": { "$ref": "#/components/responses/Success" }, "default": { "$ref": "#/components/responses/Error" } } }
    },
    "/v1/reviews": {
      "get": { "tags": ["Reviews"], "summary": "List app-scoped proof reviews", "parameters": [{ "$ref": "#/components/parameters/Limit" }, { "$ref": "#/components/parameters/Cursor" }], "responses": { "200": { "$ref": "#/components/responses/List" }, "default": { "$ref": "#/components/responses/Error" } } }
    },
    "/v1/disputes": {
      "post": { "tags": ["Disputes"], "summary": "Open a dispute", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DisputeInput" } } } }, "responses": { "201": { "$ref": "#/components/responses/Created" }, "default": { "$ref": "#/components/responses/Error" } } },
      "get": { "tags": ["Disputes"], "summary": "List app-scoped disputes", "parameters": [{ "$ref": "#/components/parameters/Limit" }, { "$ref": "#/components/parameters/Cursor" }], "responses": { "200": { "$ref": "#/components/responses/List" }, "default": { "$ref": "#/components/responses/Error" } } }
    },
    "/v1/disputes/{id}": {
