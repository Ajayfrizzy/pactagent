# Prisma always requires DATABASE_URL.
# If you use Supabase, keep DATABASE_URL on the pooled 6543 host and set DIRECT_URL to the direct 5432 host.
# If you use a plain local Postgres instance, you can set DIRECT_URL to the same value as DATABASE_URL.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require"

PORT=4000
SERVICE_ROLE=api
WORKER_HEALTH_PORT=4001
CORS_ORIGIN=http://localhost:3000
TRUST_PROXY_HOPS=0

DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=30000
DB_QUERY_TIMEOUT_MS=30000

CKB_NODE_URL=https://testnet.ckb.dev/
CKB_INDEXER_URL=https://testnet.ckb.dev/indexer
CKB_NETWORK=testnet
DEFAULT_CKB_FEE_RATE=1200
CKB_RAIL_ENABLED=false
CKB_MAINNET_ENABLED=false
CKB_CONTRACT_CODE_HASH=
CKB_CONTRACT_HASH_TYPE=type
CKB_CONTRACT_DEPLOYMENT_TX_HASH=
CKB_CONTRACT_OUTPUT_INDEX=0
CKB_CONTRACT_DEP_TYPE=code
CKB_CONFIRMATIONS=4
CKB_STALE_TRANSACTION_MS=900000
CKB_RECONCILIATION_POLL_MS=15000
CKB_SIGNER_MODE=disabled
CKB_SIGNER_PRIVATE_KEY=
CKB_SIGNER_PRIVATE_KEY_FILE=

AUTH_JWT_SECRET=
# Versioned production keyrings are JSON maps, preferably supplied through *_FILE.
# Example file: {"jwt-2026-07":"<secret>","jwt-2026-06":"<old-secret>"}
AUTH_JWT_SECRET_FILE=
AUTH_JWT_ACTIVE_KID=legacy
AUTH_JWT_KEYRING=
AUTH_JWT_KEYRING_FILE=
WEBHOOK_SECRET_ENCRYPTION_KEY=
WEBHOOK_SECRET_ENCRYPTION_KEY_FILE=
WEBHOOK_ACTIVE_KEY_ID=legacy
WEBHOOK_ENCRYPTION_KEYRING=
WEBHOOK_ENCRYPTION_KEYRING_FILE=
AUTH_TOKEN_TTL_SECS=3600
AUTH_CHALLENGE_TTL_SECS=600
ADMIN_ADDRESSES=ckt1qzda0cr08m85hc8jlnfp3zer7xulejywt49kt2rr0vthywaa50xwsqwwdhesjpuhv8lx6vqxahkqxp0gpm5h6gsad9h5h
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
ACTION_RATE_LIMIT_WINDOW_MS=60000
ACTION_RATE_LIMIT_MAX=12
V1_IP_RATE_LIMIT_WINDOW_MS=60000
V1_IP_RATE_LIMIT_MAX=300
V1_API_KEY_RATE_LIMIT_WINDOW_MS=60000
V1_API_KEY_RATE_LIMIT_MAX=600
V1_TENANT_RATE_LIMIT_MAX=1200
REDIS_URL=redis://localhost:6379
REDIS_URL_FILE=
# Production defaults to fail closed when Redis is unavailable.
RATE_LIMIT_FAIL_CLOSED=false
DB_TRANSACTION_MAX_WAIT_MS=5000
DB_TRANSACTION_TIMEOUT_MS=30000
IDEMPOTENCY_RETENTION_MS=86400000
IDEMPOTENCY_PROCESSING_LEASE_MS=300000
IDEMPOTENCY_MAX_RESPONSE_BYTES=262144
WEBHOOK_RETENTION_DAYS=30
EVENT_RETENTION_DAYS=90
JOB_RETENTION_DAYS=30
AUDIT_ARCHIVE_AFTER_DAYS=365
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_MAX_REDIRECTS=3
WEBHOOK_RESPONSE_SNIPPET_BYTES=2000
# Required in staging and production. The proxy must enforce an outbound allow policy.
WEBHOOK_EGRESS_PROXY_URL=

AGENT_INTERVAL_MS=5000
SHUTDOWN_TIMEOUT_MS=30000
WORKER_HEARTBEAT_STALE_MS=30000
WORKER_ID=
WORKER_QUEUES=webhook,settlement
WORKER_CONCURRENCY=4
JOB_LEASE_MS=60000
JOB_TIMEOUT_MS=300000
REQUIRE_WORKER_READY=false
# When true, /ready verifies both configured CKB node and indexer RPCs.
REQUIRE_SETTLEMENT_READY=false
BUILD_VERSION=development
BUILD_COMMIT=unknown
METRICS_BEARER_TOKEN=
METRICS_BEARER_TOKEN_FILE=
OTEL_SERVICE_NAME=pactagent-api
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_EXPORTER_OTLP_HEADERS_FILE=

NODE_ENV=development
RUN_DB_INTEGRATION_TESTS=false
REDIS_INTEGRATION_URL=
SEED_OWNER_ID=seed-developer
SEED_SANDBOX_API_KEY=
SEED_SANDBOX_FULL_API_KEY=
SEED_SANDBOX_WEBHOOK_SECRET=
SERVICE_NAME=pactagent-server
