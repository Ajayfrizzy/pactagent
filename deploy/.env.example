# Copy to /opt/pactagent/<environment>/.env on the VPS. Never commit real values.
NODE_ENV=production
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<supabase-pooler>:6543/postgres?pgbouncer=true&sslmode=require
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@<supabase-direct>:5432/postgres?sslmode=require
AUTH_JWT_ACTIVE_KID=jwt-2026
WEBHOOK_ACTIVE_KEY_ID=webhook-2026
ADMIN_ADDRESSES=replace-with-operator-addresses
CORS_ORIGIN=https://staging.example.invalid
CKB_NETWORK=testnet
CKB_RAIL_ENABLED=false
CKB_MAINNET_ENABLED=false
AUTH_JWT_KEYRING_SOURCE=/opt/pactagent/secrets/jwt_keyring.json
WEBHOOK_KEYRING_SOURCE=/opt/pactagent/secrets/webhook_keyring.json
METRICS_BEARER_TOKEN_SOURCE=/opt/pactagent/secrets/metrics_bearer_token
