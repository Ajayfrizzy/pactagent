{
  "title": "PactAgent Settlement",
  "uid": "pactagent-settlement",
  "schemaVersion": 39,
  "panels": [
    {
      "type": "timeseries",
      "title": "Reconciliation outcomes",
      "targets": [
        {
          "expr": "sum by (outcome) (rate(pactagent_settlement_reconciliations_total[5m]))"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "CKB provider latency",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(pactagent_provider_request_duration_seconds_bucket{provider=\"ckb\"}[5m])))"
        }
      ]
    }
  ]
}
