{
  "title": "PactAgent Queue",
  "uid": "pactagent-queue",
  "schemaVersion": 39,
  "panels": [
    {
      "type": "timeseries",
      "title": "Queued and dead-letter jobs",
      "targets": [
        { "expr": "pactagent_jobs_queued" },
        { "expr": "pactagent_jobs_dead_letter_total" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Retries",
      "targets": [
        {
          "expr": "sum by (queue,outcome) (rate(pactagent_job_retries_total[5m]))"
        }
      ]
    }
  ]
}
