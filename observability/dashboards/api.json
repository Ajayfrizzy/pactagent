{
  "title": "PactAgent API",
  "uid": "pactagent-api",
  "schemaVersion": 39,
  "panels": [
    {
      "type": "timeseries",
      "title": "Request rate",
      "targets": [
        { "expr": "sum by (status) (rate(pactagent_http_requests_total[5m]))" }
      ]
    },
    {
      "type": "timeseries",
      "title": "p95 latency",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(pactagent_http_request_duration_seconds_bucket[5m])))"
        }
      ]
    }
  ]
}
